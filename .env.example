# pkp-e2e environment.
#
#   cp .env.example .env
#
# Values already exported in the shell win over this file.
#
# This file names the APP CHECKOUTS the suites run against. Per-app secrets
# (database credentials, TEST_API_KEY) live in each checkout's own
# .env.playwright file, exactly as before — see docs/process/harness.md.
# Set only the apps you have; scripts fail with a clear message otherwise.

OJS_ROOT=/path/to/ojs
OMP_ROOT=/path/to/omp
OPS_ROOT=/path/to/ops

# Optional overrides (defaults shown; ports are per-app in bin/apps.js):
# PLAYWRIGHT_WORKERS=4
# MAILPIT_URL=http://127.0.0.1:8025
