# pkp-e2e environment.
#
#   cp .env.example .env
#
# Values already exported in the shell win over this file.
#
# This file names the APP CHECKOUTS the suites run against. The default is
# the SELF-CONTAINED setup: `npm run fetch-apps` provisions checkouts/<app>
# inside this repo (fork origin, fetch-only pkp upstream at main, deps +
# UI build, test DB + config.test.inc.php + .env.playwright), so the campaign
# never drives a development checkout. Per-app secrets stay in each
# checkout's own .env.playwright — see docs/process/harness.md.
# Set only the apps you have; scripts fail with a clear message otherwise.

OJS_ROOT=./checkouts/ojs
OMP_ROOT=./checkouts/omp
OPS_ROOT=./checkouts/ops

# Optional overrides (defaults shown; ports are per-app in bin/apps.js):
# PLAYWRIGHT_WORKERS=4
# MAILPIT_URL=http://127.0.0.1:8025
