{
  "name": "pkp-e2e",
  "private": true,
  "description": "Playwright e2e suites, seeding harness, specs and process docs for OJS/OMP/OPS. Runs against app checkouts named in .env; `npm run mount` copies the PHP overlays into them.",
  "scripts": {
    "fetch-apps": "node bin/fetch-apps.js",
    "fetch-old-lines": "node bin/fetch-old-lines.js",
    "fetch-datasets": "node bin/fetch-datasets.js",
    "mount": "node bin/mount.js",
    "unmount": "node bin/unmount.js",
    "test:ojs": "node bin/test-app.js ojs",
    "test:omp": "node bin/test-app.js omp",
    "test:ops": "node bin/test-app.js ops",
    "reset:ojs": "node bin/with-app.js ojs shared/playwright/reset.js",
    "reset:omp": "node bin/with-app.js omp shared/playwright/reset.js",
    "reset:ops": "node bin/with-app.js ops shared/playwright/reset.js",
    "questions": "node bin/open-questions.mjs",
    "backlog": "node bin/backlog.mjs",
    "api-routes": "node bin/api-routes.mjs",
    "seed-facts": "node bin/seed-facts.js",
    "dataset-facts": "node bin/dataset-facts.js",
    "probe-servers": "node bin/probe-servers.js",
    "fleet-prep": "node bin/fleet-prep.js",
    "cypress": "node bin/cypress-line.js",
    "test:final": "node bin/test-final.js",
    "shard-timings": "node bin/shard-timings.js",
    "lint:suite": "node bin/lint-suite.js",
    "lint:probe-imports": "! git grep -l \"playwright/probe\" -- apps shared/playwright/tests shared/playwright/pages shared/playwright/support",
    "check-models": "node bin/check-models.mjs",
    "report-models": "node bin/report-models.mjs",
    "regressions": "node bin/regression-metrics.mjs",
    "api-traffic": "node bin/api-traffic.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0"
  }
}
