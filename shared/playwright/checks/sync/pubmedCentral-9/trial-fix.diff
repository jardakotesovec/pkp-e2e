+    /**
+     * @copydoc PubObjectsExportPlugin::markRegistered()
+     *
+     * A package downloaded with Export and delivered by hand is then marked registered,
+     * so record the revision it was delivered as, as a deposit from OJS does.
+     */
+    public function markRegistered($objects)
+    {
+        foreach ($objects as $object) {
+            if ($this->continuesHistory($object)) {
+                $submission = $this->submissionOf($object);
+                $context = Application::getContextDAO()->getById($submission->getData('contextId'));
+                $this->recordDelivery($object, $this->packageNames($object, $context, $submission)['revision']);
+            }
+        }
+        parent::markRegistered($objects);
+    }
+
+    /**
+     * @copydoc PubObjectsExportPlugin::updateObject()
+     *
+     * Repo's edit() saves every setting of the object it is given and removes the ones it
+     * lacks, so keep the object in step: a later save from it would otherwise undo this one.
+     */
+    protected function updateObject(Submission|Publication|Issue|Galley $object, ?array $editParams = [])
+    {
+        parent::updateObject($object, $editParams);
+        foreach ($editParams ?? [] as $name => $value) {
+            $object->setData($name, $value);
+        }
+    }
