From 43dc6405b11910e6398d3d8a412f10fa26beda46 Mon Sep 17 00:00:00 2001
From: Jarda Kotesovec <jarda_kotesovec@sfu.ca>
Date: Sat, 31 Oct 2026 23:50:32 +0000
Subject: [PATCH 1/2] pkp/pkp-lib#12780 Restore "Keep me logged in" after the
 session ends

Since 3407fc5bc0 nothing asks the guard for the user before the session
is first saved, so the "remember me" cookie is never read and a
remembered user is signed out once the session ends.

- PKPAuthenticateSession::handle() asks the guard for the user first,
  so its "remember me" restore runs before the session is saved.
- PKPSessionGuard::userFromRecaller() writes the restored user into the
  session as a sign-in does (userId, username, email), removes a cookie
  that signs no one in, and does not restore on API requests.
- updateSessionCookieToResponse() no longer clears the "remember me"
  cookie on every session update; logoutOtherDevices() sends the cookie
  the guard queues with the new password hash.
- PKPAuthenticateSession::logout() ends only the current device.
- PKPUserProvider::updateRememberToken() stores the token it is given.
---
 classes/core/PKPSessionGuard.php              | 51 ++++++++++++++++++-
 classes/core/PKPUserProvider.php              | 11 ++--
 classes/middleware/PKPAuthenticateSession.php |  8 ++-
 3 files changed, 62 insertions(+), 8 deletions(-)

diff --git a/classes/core/PKPSessionGuard.php b/classes/core/PKPSessionGuard.php
index afd3a0f97b..769d538d62 100644
--- a/classes/core/PKPSessionGuard.php
+++ b/classes/core/PKPSessionGuard.php
@@ -105,6 +105,52 @@ class PKPSessionGuard extends SessionGuard
         return $this->session->get('userId');
     }
 
+    /**
+     * @copydoc \Illuminate\Auth\SessionGuard::userFromRecaller($recaller)
+     *
+     * A user signed back in from the "remember me" cookie gets the same session data as a sign-in
+     * (userId, username, email), so that every reader of the session agrees on the user; a cookie
+     * that signs no one in is removed. Not on API requests, whose responses do not carry the cookies.
+     */
+    protected function userFromRecaller($recaller)
+    {
+        if ($this->recallAttempted) {
+            return null;
+        }
+
+        if (Application::get()->getRequest()->getRouter() instanceof APIRouter) {
+            $this->recallAttempted = true;
+            return null;
+        }
+
+        $user = parent::userFromRecaller($recaller);
+
+        if ($user) {
+            $this->setUserDataToSession($user);
+            Registry::set('user', $user);
+        } elseif ($recaller->valid()) {
+            $this->getCookieJar()->queue($this->getCookieJar()->forget($this->getRecallerName()));
+            $this->updateSessionCookieToResponse();
+        }
+
+        return $user;
+    }
+
+    /**
+     * @copydoc \Illuminate\Auth\SessionGuard::logoutOtherDevices($password)
+     *
+     * Also sends the "remember me" cookie the parent queues with the new password hash,
+     * so this browser keeps its remembered sign-in.
+     */
+    public function logoutOtherDevices($password)
+    {
+        $user = parent::logoutOtherDevices($password);
+
+        $this->updateSessionCookieToResponse();
+
+        return $user;
+    }
+
     /**
      * Sign In as different user
      */
@@ -212,11 +258,12 @@ class PKPSessionGuard extends SessionGuard
         /** @var \Illuminate\Http\Response $response */
         $response = app()->get(\Illuminate\Http\Response::class);
 
-        // clear out the previous session and remember me cookies
+        // clear out the previous session cookie and any remember me cookie already set on this response;
+        // the browser keeps its remember me cookie unless a sign in or sign out queued one (below)
         foreach ([$session->getName(), $this->getRecallerName()] as $cookieName) {
             $response->headers->removeCookie($cookieName, $config['path'], $config['domain']);
-            $response->headers->clearCookie($cookieName, $config['path'], $config['domain']);
         }
+        $response->headers->clearCookie($session->getName(), $config['path'], $config['domain']);
 
         $cookie = new Cookie(
             name: $session->getName(),
diff --git a/classes/core/PKPUserProvider.php b/classes/core/PKPUserProvider.php
index 718611119d..b790c9c46a 100755
--- a/classes/core/PKPUserProvider.php
+++ b/classes/core/PKPUserProvider.php
@@ -100,12 +100,13 @@ class PKPUserProvider implements UserProvider
      */
     public function updateRememberToken(UserContract $user, $token)
     {
-        if ($user->getRememberToken() === $token) {
-            return;
-        }
-
+        // The guard sets the new token on the user before calling this, so always store it
         $user->setRememberToken($token);
-        Repo::user()->edit($user);
+
+        $this->connection
+            ->table($this->table)
+            ->where($user->getAuthIdentifierName(), $user->getAuthIdentifier())
+            ->update([$user->getRememberTokenName() => $token]);
     }
 
     /**
diff --git a/classes/middleware/PKPAuthenticateSession.php b/classes/middleware/PKPAuthenticateSession.php
index aecfa3ee66..19c23385ff 100644
--- a/classes/middleware/PKPAuthenticateSession.php
+++ b/classes/middleware/PKPAuthenticateSession.php
@@ -32,6 +32,9 @@ class PKPAuthenticateSession extends \Illuminate\Session\Middleware\Authenticate
      */
     public function handle($request, Closure $next)
     {
+        // Sign the user back in from the "remember me" cookie, if any, before the session is first saved
+        $this->guard()->user();
+
         $response = parent::handle($request, $next);
 
         if ($request->hasSession()
@@ -61,10 +64,13 @@ class PKPAuthenticateSession extends \Illuminate\Session\Middleware\Authenticate
             'newIp' => $request->ip(),
         ]);
 
-        Auth::logout();
+        // End this browser's session and remove its "remember me" cookie, as Laravel's AuthenticateSession
+        // does, without cycling the token that keeps the user's other browsers remembered
+        Auth::logoutCurrentDevice();
 
         $request->session()->invalidate();
         $request->session()->regenerateToken();
+        app()->get('auth.driver')->updateSessionCookieToResponse();
 
         return $this->redirectTo($request);
     }
