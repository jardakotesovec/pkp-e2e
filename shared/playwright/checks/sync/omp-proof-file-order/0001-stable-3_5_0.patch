From 0d549e3c6f47809e4740ad0d79afde84dce50352 Mon Sep 17 00:00:00 2001
From: Jarda Kotesovec <jarda_kotesovec@sfu.ca>
Date: Fri, 23 Oct 2026 21:01:59 +0000
Subject: [PATCH] Order submission files by id when created_at ties

created_at has one-second precision, so files created in the same
second (several uploads in a row, or the copies one decision makes)
came back from the Collector in an order the database picks, and that
order could change between page loads. Break the tie by
submission_file_id, newest first, matching the created_at order.

This also makes OMP's CallanSubmission.cy.js and
Z_MonographViewDCMetadata.cy.js stable: both tick the first file in
"Select Files" and expect the newest upload.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 classes/submissionFile/Collector.php | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/classes/submissionFile/Collector.php b/classes/submissionFile/Collector.php
index b6325b141c..6af24755f2 100644
--- a/classes/submissionFile/Collector.php
+++ b/classes/submissionFile/Collector.php
@@ -269,7 +269,9 @@ class Collector implements CollectorInterface
             $qb->where('sf.file_stage', '!=', SubmissionFile::SUBMISSION_FILE_DEPENDENT);
         }
 
-        $qb->orderBy('sf.created_at', 'desc');
+        // created_at has one-second precision: break ties by id so files created in the same second keep a stable order
+        $qb->orderBy('sf.created_at', 'desc')
+            ->orderBy('sf.submission_file_id', 'desc');
 
         if ($this->count !== null) {
             $qb->limit($this->count);
-- 
