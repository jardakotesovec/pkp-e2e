+
+/**
+ * In a citation's leading "[…]" or "(…)", replace the numbers that are the
+ * citation's own reference IDs with their list numbers; leave other numbers
+ * (pages, years) alone.
+ */
+function updateLeadingReferenceIds(citation, ids, numbers) {
+	if (numbers.some((number) => number == null)) return;
+	const group = citation.textContent.match(/^(\s*[[(])([^\])]*)[\])]/);
+	if (!group) return;
+	const start = group[1].length;
+	const replacements = [...group[2].matchAll(/\d+/g)]
+		.filter((token) => ids.includes(token[0]))
+		.map((token) => ({
+			start: start + token.index,
+			end: start + token.index + token[0].length,
+			text: String(numbers[ids.indexOf(token[0])]),
+		}));
+	if (replacements.length) replaceTextRanges(citation, replacements);
 }
 
