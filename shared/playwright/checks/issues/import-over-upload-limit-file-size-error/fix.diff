+			if (maxSize && err.file.size > maxSize) {
+				message = tooBig
+						.replace('{{filesize}}',
+								String(Math.round(err.file.size / 1024 / 10.24) / 100))
+						.replace('{{maxFilesize}}',
+								String(Math.round(maxSize / 1024 / 10.24) / 100));
+			}
+		}
+		this.showError(message);
 	};
 
 
