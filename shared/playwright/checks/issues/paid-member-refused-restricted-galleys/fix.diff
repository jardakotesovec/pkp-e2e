     /**
+     * When the user's membership of the journal ends, from the journal's completed
+     * OJSPaymentManager::PAYMENT_TYPE_MEMBERSHIP payments: each one adds a year, counted
+     * from its own date or from the end of the year before, whichever is later.
+     *
+     * @return ?int The end as a timestamp, or null when the user never paid a membership here
+     */
+    public function getMembershipEnd(?int $userId, int $contextId): ?int
+    {
+        if (!$userId) {
+            return null;
+        }
+        $end = null;
+        $paidAt = DB::table('completed_payments')
+            ->where('user_id', $userId)
+            ->where('context_id', $contextId)
+            ->where('payment_type', OJSPaymentManager::PAYMENT_TYPE_MEMBERSHIP)
+            ->orderBy('timestamp')
+            ->pluck('timestamp');
+        foreach ($paidAt as $timestamp) {
+            $from = max($end ?? 0, strtotime($timestamp));
+            $end = mktime(23, 59, 59, date('m', $from), date('d', $from), date('Y', $from) + 1);
+        }
+        return $end;
+    }
