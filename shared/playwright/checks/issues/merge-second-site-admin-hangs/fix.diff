     /**
+     * build a permission map for a site administrator over a set of users:
+     * every user but another site administrator, whom no one may administer
+     * (Validation::getAdministrationLevel())
+     */
+    public function permissionMapForSiteAdmin(array $userIds): array
+    {
+        $userIds = array_values(array_unique(array_map('intval', $userIds)));
+        if (empty($userIds)) {
+            return [];
+        }
+
+        $siteAdminIds = UserUserGroup::query()
+            ->withUserIds($userIds)
+            ->withActive()
+            ->whereHas('userGroup', fn ($q) => $q->withRoleIds([Role::ROLE_ID_SITE_ADMIN]))
+            ->pluck('user_id')
+            ->all();
+
+        $map = array_fill_keys($userIds, true);
+        foreach ($siteAdminIds as $id) {
+            $map[(int)$id] = false;
+        }
+        return $map;
+    }
+
