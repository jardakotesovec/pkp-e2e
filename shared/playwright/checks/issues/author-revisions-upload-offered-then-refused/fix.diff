+// Whether the server takes a revision file from the author on this round, as
+// far as the round's status tells (SubmissionFileStageAccessPolicy): once
+// revisions were requested, or once the round was accepted. An internal round
+// also reads accepted when the submission was sent on to external review, a
+// decision the server does not count, so an accepted internal round counts
+// only when the submission has no external review round.
+function canAuthorUploadRevisions({stageId, reviewRound, reviewRounds}) {
+	if (
+		[
+			pkp.const.REVIEW_ROUND_STATUS_REVISIONS_REQUESTED,
+			pkp.const.REVIEW_ROUND_STATUS_REVISIONS_SUBMITTED,
+			pkp.const.REVIEW_ROUND_STATUS_RESUBMIT_FOR_REVIEW,
+			pkp.const.REVIEW_ROUND_STATUS_RESUBMIT_FOR_REVIEW_SUBMITTED,
+		].includes(reviewRound?.statusId)
+	) {
+		return true;
+	}
+	if (reviewRound?.statusId !== pkp.const.REVIEW_ROUND_STATUS_ACCEPTED) {
+		return false;
+	}
+	return (
+		stageId === pkp.const.WORKFLOW_STAGE_ID_EXTERNAL_REVIEW ||
+		!reviewRounds?.some(
+			(round) => round.stageId === pkp.const.WORKFLOW_STAGE_ID_EXTERNAL_REVIEW,
+		)
+	);
+}
