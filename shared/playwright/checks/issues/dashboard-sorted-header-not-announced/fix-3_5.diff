 const tableContext = inject('tableContext');
 
+/**
+ * The sort state a screen reader announces. Only the column the table is
+ * sorted by carries it, as the WAI-ARIA sortable table pattern asks.
+ */
+const ariaSort = computed(() => {
+	const sortDescriptor = tableContext.sortDescriptor?.value;
+	if (
+		props.allowsSorting &&
+		sortDescriptor?.column === props.id &&
+		['ascending', 'descending'].includes(sortDescriptor.direction)
+	) {
+		return sortDescriptor.direction;
+	}
+	return undefined;
+});
+
 onMounted(() => {
