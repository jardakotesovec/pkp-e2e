+    /**
+     * @copydoc GridHandler::saveSequence()
+     *
+     * Also announces the galleys in their stored order, as "Save" and "Delete" announce
+     * the galley they changed, so that a view built from the galleys (the submission
+     * wizard's Review step) can follow a new order.
+     */
+    public function saveSequence($args, $request)
+    {
+        $json = parent::saveSequence($args, $request);
+        /** @var GenreDAO $genreDao */
+        $genreDao = DAORegistry::getDAO('GenreDAO');
+        $genres = $genreDao->getByContextId($request->getContext()->getId())->toAssociativeArray();
+        $galleys = Repo::galley()
+            ->getCollector()
+            ->filterByPublicationIds([$this->getPublication()->getId()])
+            ->getMany();
+        $json->setGlobalEvent('galleys:ordered', [
+            'galleys' => Repo::galley()
+                ->getSchemaMap($this->getSubmission(), $this->getPublication(), $genres)
+                ->mapMany($galleys)
+                ->values()
+                ->all(),
+        ]);
+        return $json;
+    }
+
